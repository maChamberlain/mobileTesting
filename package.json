{
  "name": "mobile-testing",
  "version": "1.0.0",
  "private": true,
  "description": "Automated mobile browser testing with Appium + WebdriverIO + TypeScript",
  "scripts": {
    "test": "wdio run ./wdio.conf.ts",
    "test:smoke": "wdio run ./wdio.conf.ts --mochaOpts.grep @smoke",
    "test:search": "wdio run ./wdio.conf.ts --mochaOpts.grep @search"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@wdio/appium-service": "^9.4.5",
    "@wdio/cli": "^9.4.5",
    "@wdio/globals": "^9.4.5",
    "@wdio/local-runner": "^9.4.5",
    "@wdio/mocha-framework": "^9.4.5",
    "@wdio/spec-reporter": "^9.4.5",
    "appium": "^3.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
